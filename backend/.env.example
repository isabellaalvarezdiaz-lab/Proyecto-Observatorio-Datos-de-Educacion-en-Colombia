# Copie este archivo como backend/.env y ajuste lo que necesite. Todas son opcionales.
# desarrollo | produccion (en producción los errores 500 no muestran detalles internos)
ENTORNO=desarrollo
# Base de resultados (SQLite por defecto en backend/observatorio.db)
DATABASE_URL=sqlite:///./observatorio.db
# Cargar los CSV de resultados/ a la base si está vacía al arrancar
CARGAR_AL_INICIAR=true
# Rutas (por defecto, las carpetas del repositorio)
# RESULTADOS_DIR=../resultados
# MODELO_IMPUTADOR=../modelos/imputador_escrita.json
# DOCS_DIR=../docs
# Asistente: sin clave responde con plantillas (cifras + fuentes). Con clave, el LLM solo redacta.
LLM_API_KEY=
LLM_MODELO=claude-haiku-5-5
LOG_LEVEL=INFO
