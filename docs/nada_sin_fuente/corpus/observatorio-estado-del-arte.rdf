    <bib:Article rdf:about="https://epaa.asu.edu/index.php/epaa/article/view/7310">
        <z:itemType>journalArticle</z:itemType>
        <dcterms:isPartOf rdf:resource="urn:issn:1068-2341"/>
        <bib:authors>
